#include "build/version.h"
101 ICON "../Assets/App.ico"
1 24 "build/app.manifest"
1 VERSIONINFO
 FILEVERSION APP_VERSION_NUM
 PRODUCTVERSION APP_VERSION_NUM
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "WhereIsMyCursor\0"
   VALUE "ProductName", "WhereIsMyCursor\0"
   VALUE "FileVersion", APP_VERSION_STR "\0"
   VALUE "ProductVersion", APP_VERSION_STR "\0"
   VALUE "OriginalFilename", "WhereIsMyCursor.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
